{
  "manifest_version": 2,
  "name": "Ark helper",
  "version": "1.0",
  "description": "Built-in helper for the Ark browser (page zoom, theme color, page text).",
  "browser_specific_settings": { "gecko": { "id": "ark-helper@vis.dev" } },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end" }
  ],
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons", "<all_urls>"]
}
