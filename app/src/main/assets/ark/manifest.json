{
  "manifest_version": 2,
  "name": "Ark helper",
  "version": "1.2",
  "description": "Built-in helper for the Ark browser (page zoom, theme color, page text, sign-in detection for fire mode).",
  "browser_specific_settings": {
    "gecko": {
      "id": "ark-helper@vis.dev"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "cookies",
    "geckoViewAddons",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
